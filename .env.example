# Prisma SQLite database URL — MUST be an absolute path so `prisma` and the
# Next.js server resolve it identically regardless of the working directory.
DATABASE_URL="file:/home/z/my-project/apps/47-tweet-thread-composer/db/custom.db"

# Disable the live LLM and fall back to the deterministic mock provider.
# Useful for offline development and for running `bun test` without network.
# PKC_DISABLE_LLM=1

# z-ai-web-dev-sdk reads its credentials from environment variables. In the
# sandbox the SDK is pre-provisioned; on your own machine you may need to set:
# ZAI_API_KEY=...
